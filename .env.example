# RxDiff Stage 3 Environment Configuration Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any real API keys to version control.

# Google Gemini API Key (Server-side only; never use VITE_ prefix)
GEMINI_API_KEY=

# Verified model for RxDiff multimodal extraction
GEMINI_MODEL=gemini-3.6-flash

# Mock extraction mode for non-production automated testing (true/false)
RXDIFF_MOCK_EXTRACTION=false
